# --- App ---
# Only needed once a custom domain is attached. On Vercel this is derived from
# the platform's own domain variables, and locally it defaults to
# http://localhost:3000, so it can stay empty in both.
APP_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# The Supabase dashboard now calls this the "publishable key" and it looks like
# sb_publishable_... . It goes here: a publishable key works everywhere the
# legacy anon JWT did, and the variable keeps the ANON_KEY name because that is
# what src/lib/env.ts validates.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS - never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Notifications ---
# Transactional mail through Resend. Without these the app still works: an
# action that would have sent a message succeeds and says it could not send,
# rather than failing or pretending it did.
RESEND_API_KEY=
MAIL_FROM=

# --- Scheduled work ---
# Shared secret for /api/cron/expire-objections, which accepts deliveries whose
# objection window has closed. The route refuses to run without it.
CRON_SECRET=

# ---------------------------------------------------------------------------
# NOT WIRED UP YET -- do not set these, and do not add them to a deployment.
#
# There is no payment or e-invoicing code in the repository: no webhook route,
# no gateway client, no provider selection. The names below are a record of the
# integration surface the design calls for, so that whoever builds it knows
# what to ask each provider for. Setting them today does nothing.
#
#   Gateway (one of):  PAYTR_MERCHANT_ID / _KEY / _SALT
#                      IYZICO_API_KEY / _SECRET_KEY / _BASE_URL
#   Webhook HMAC:      PAYMENT_WEBHOOK_SECRET
#   e-Invoicing:       PARASUT_CLIENT_ID / _CLIENT_SECRET / _USERNAME /
#                      _PASSWORD / _COMPANY_ID
#                      KOLAYBI_API_KEY
# ---------------------------------------------------------------------------
