# --- App ---
# Only needed once a custom domain is attached. On Vercel this is derived from
# the platform's own domain variables, and locally it defaults to
# http://localhost:3000, so it can stay empty in both.
APP_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# The Supabase dashboard now calls this the "publishable key" and it looks like
# sb_publishable_... . It goes here: a publishable key works everywhere the
# legacy anon JWT did, and the variable keeps the ANON_KEY name because that is
# what src/lib/env.ts validates.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS - never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Notifications ---
# Transactional mail through Resend. Without these the app still works: an
# action that would have sent a message succeeds and says it could not send,
# rather than failing or pretending it did.
RESEND_API_KEY=
MAIL_FROM=

# --- Scheduled work ---
# Shared secret for /api/cron/expire-objections, which accepts deliveries whose
# objection window has closed. The route refuses to run without it.
CRON_SECRET=

# The one operator's inbox for /api/cron/admin-digest's daily summary
# (QA queue, pending payments/invoices, disputes, unclaimed invites). Without
# it the route no-ops with an error, same "fails loud, not silent" pattern
# as the rest of notify/email.ts.
ADMIN_DIGEST_EMAIL=

# --- Tier2 Agentic QA (src/lib/qa/agent.ts) ---
# Judges a delivery's staging URL against the contract's acceptance criteria.
# Runs as an ordinary function call (Playwright via @sparticuz/chromium +
# playwright-core, no separate always-on worker), triggered immediately after
# choose_qa_tier() and as a daily safety-net sweep (/api/cron/process-tier2-qa).
# Without this, the agent logs an error and every run escalates to TIER3.
OPENAI_API_KEY=

# --- QA tier order payment (LemonSqueezy) ---
# LemonSqueezy is a Merchant of Record, used only for the fixed TIER3/TIER4
# reviewer fee (qa_tier_orders.fee_kurus) -- it lets Lancerix collect that one
# fixed-price fee without Lancerix itself being a registered company yet.
# It is not a substitute for a PayTR/iyzico marketplace leg and must never be
# pointed at a contract's variable project_amount_kurus. Without these,
# payQaOrder() falls back to a mock checkout URL for local development.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
# Required for the webhook route to run at all -- it fails closed (500) with
# no default if this is unset, rather than verifying against a guessable value.
LEMONSQUEEZY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# NOT WIRED UP YET -- do not set these, and do not add them to a deployment.
#
# This is the PayTR/iyzico marketplace leg for the variable, split project
# payment (client -> escrow hold -> freelancer payout). It needs Lancerix to
# be a registered company first (merchant/marketplace onboarding), which
# LemonSqueezy above does not require. The names below are a record of the
# integration surface the design calls for, so that whoever builds it knows
# what to ask each provider for. Setting them today does nothing.
#
#   Gateway (one of):  PAYTR_MERCHANT_ID / _KEY / _SALT
#                      IYZICO_API_KEY / _SECRET_KEY / _BASE_URL
#   Webhook HMAC:      PAYMENT_WEBHOOK_SECRET
#   e-Invoicing:       PARASUT_CLIENT_ID / _CLIENT_SECRET / _USERNAME /
#                      _PASSWORD / _COMPANY_ID
#                      KOLAYBI_API_KEY
# ---------------------------------------------------------------------------
