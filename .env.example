# --- App ---
# Only needed once a custom domain is attached. On Vercel this is derived from
# the platform's own domain variables, and locally it defaults to
# http://localhost:3000, so it can stay empty in both.
APP_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# The Supabase dashboard now calls this the "publishable key" and it looks like
# sb_publishable_... . It goes here: a publishable key works everywhere the
# legacy anon JWT did, and the variable keeps the ANON_KEY name because that is
# what src/lib/env.ts validates.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS - never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Escrow / Marketplace gateway (PayTR or iyzico) ---
PAYMENT_PROVIDER=paytr

PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Shared secret used to verify inbound gateway webhooks.
PAYMENT_WEBHOOK_SECRET=

# --- e-Invoicing (Parasut or KolayBi) ---
INVOICE_PROVIDER=parasut

PARASUT_CLIENT_ID=
PARASUT_CLIENT_SECRET=
PARASUT_USERNAME=
PARASUT_PASSWORD=
PARASUT_COMPANY_ID=

KOLAYBI_API_KEY=
